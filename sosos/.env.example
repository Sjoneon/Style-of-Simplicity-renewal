# Backend env example (local/prod 공통 기준)
# 실제 값은 git에 커밋하지 말고 로컬/배포 환경변수로만 관리

# ---- Runtime profile / server ----
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8085

# ---- Database (required) ----
DB_URL=jdbc:mysql://localhost:3306/SOS_db
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# ---- CORS (comma-separated) ----
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# ---- Storage strategy ----
APP_STORAGE_TYPE=local
APP_UPLOAD_BASE_DIR=uploads

# ---- S3 (required when APP_STORAGE_TYPE=s3) ----
APP_STORAGE_S3_BUCKET=your_bucket_name
APP_STORAGE_S3_REGION=ap-northeast-2
APP_STORAGE_S3_PREFIX=sosos
APP_STORAGE_S3_PUBLIC_BASE_URL=
APP_STORAGE_S3_ENDPOINT=
APP_STORAGE_S3_PATH_STYLE_ACCESS=false

# ---- AI ----
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
AI_MAX_INPUT_LENGTH=180
AI_MAX_CANDIDATES=5

# ---- TossPayments (test) ----
TOSS_ENABLED=false
# Example: test_gsk_docs_xxxxxxxxxxxxx
TOSS_SECRET_KEY=
# Optional override
TOSS_CONFIRM_URL=https://api.tosspayments.com/v1/payments/confirm
