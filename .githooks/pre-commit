#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

if command -v pwsh >/dev/null 2>&1; then
  pwsh -NoProfile -ExecutionPolicy Bypass -File "scripts/check-korean-garbled.ps1"
elif command -v powershell >/dev/null 2>&1; then
  powershell -NoProfile -ExecutionPolicy Bypass -File "scripts/check-korean-garbled.ps1"
else
  echo "PowerShell not found. Install pwsh or Windows PowerShell to run garbled-Korean pre-commit check." >&2
  exit 1
fi
